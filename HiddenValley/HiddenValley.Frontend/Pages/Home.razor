@page "/"

<PageTitle>Bienvenido al sistema Hidden Valley</PageTitle>

<div class="welcome-wrapper">

    <div class="welcome-hero">
        <img src="logo.png.jpeg" alt="Hidden Valley" class="welcome-logo" />
        <h1 class="welcome-title">Sistema de Control Operativo</h1>
        <p class="welcome-subtitle">¡Hola, Administrador! Bienvenido al sistema de Hidden Valley </p>
    </div>

    <div class="quick-access-grid">
        <a href="/personas" class="quick-card">
            <i class="fas fa-user"></i>
            <span>Personas</span>
        </a>

        <a href="/reservaciones" class="quick-card">
            <i class="fas fa-calendar-check"></i>
            <span>Reservaciones</span>
        </a>

        <a href="/cabanas" class="quick-card">
            <i class="fas fa-house"></i>
            <span>Cabañas</span>
        </a>

        <a href="/empleados" class="quick-card">
            <i class="fas fa-users"></i>
            <span>Empleados</span>
        </a>

        <a href="/clientes" class="quick-card">
            <i class="fas fa-user-friends"></i>
            <span>Clientes</span>
        </a>

        <a href="/servicios" class="quick-card">
            <i class="fas fa-concierge-bell"></i>
            <span>Servicio</span>
        </a>

        <a href="/reservacion-servicios" class="quick-card">
            <i class="fas fa-calendar-plus"></i>
            <span>Reservacion Servicio</span>
        </a>

        <a href="/dashboard" class="quick-card">
            <i class="fas fa-chart-line"></i>
            <span>Dashboard</span>
        </a>

    </div>

</div>
