@page "/servicios"
@using HiddenValley.Shared.DTOs
@using HiddenValley.Frontend.Interfaces
@using System.Globalization
@inject IServicioService ServicioService
@inject ITipoServicioClient TipoServicioService
@inject IJSRuntime JS

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="fw-bold text-dark m-0" style="font-size: 2.5rem;">Servicios</h1>
        </div>
        <div class="d-flex gap-2">
            <button class="btn text-white fw-bold px-3 py-2 shadow-sm" style="background-color: #5d4037; border-radius: 6px; font-size: 1rem;" @onclick="AbrirModalCategorias">
                Categorías
            </button>
            <button class="btn text-white fw-bold px-4 py-2 shadow-sm" style="background-color: #1b4d22; border-radius: 6px; font-size: 1rem;" @onclick="AbrirModal">
                Registrar Nuevo Servicio
            </button>
        </div>
    </div>

    <div class="d-flex gap-3 mb-4 align-items-center" style="max-width: 900px;">
        <div class="input-group shadow-sm rounded-pill border bg-white px-2 py-1" style="max-width: 160px;">
            <span class="input-group-text bg-white border-0 text-muted fw-bold" style="font-size: 0.9rem;">ID</span>
            <input type="number" class="form-control border-0 bg-white m-0 p-1" placeholder="Buscar ID..." @bind-value="searchId" @bind-value:event="oninput" @onkeyup="ExecuteSearch" />
        </div>
        <div class="input-group shadow-sm rounded-pill border bg-white flex-grow-1 px-3 py-1">
            <input type="text" class="form-control border-0 bg-white m-0 p-1" placeholder="Buscar por tipo o estado..." @bind-value="searchNombre" @bind-value:event="oninput" @onkeyup="ExecuteSearch" />
        </div>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden mb-4" style="border-radius: 12px;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #5a4238; color: white; font-size: 1.05rem;">
                    <tr>
                        <th class="ps-4 py-3" style="width: 90px;">ID</th>
                        <th class="py-3">Nombre del Servicio</th>
                        <th class="py-3">Descripción</th>
                        <th class="py-3">Precio</th>
                        <th class="text-center py-3" style="width: 240px;">Acciones Administrativas</th>
                    </tr>
                </thead>
                <tbody style="font-size: 1rem;">
                    @if (listaServiciosVisual == null)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="spinner-border text-success" role="status"></div>
                                <p class="text-muted mt-2 mb-0">Cargando registros...</p>
                            </td>
                        </tr>
                    }
                    else if (!listaServiciosVisual.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5 fw-bold">
                                No hay servicios que coincidan con la búsqueda.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var serv in listaServiciosVisual)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge text-white fw-bold d-flex align-items-center justify-content-center" 
                                          style="width: 32px; height: 32px; font-size: 0.95rem; background-color: #7A6356; border-radius: 6px;">
                                        @serv.IdServicio
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">
                                    @if (idServicioEdicion == serv.IdServicio)
                                    {
                                        <input type="text" class="form-control form-control-sm shadow-sm" @bind-value="servicioEdicion.Nombre" />
                                    }
                                    else
                                    {
                                        @serv.Nombre
                                    }
                                </td>
                                <td class="text-muted">
                                    @if (idServicioEdicion == serv.IdServicio)
                                    {
                                        <input type="text" class="form-control form-control-sm shadow-sm" @bind-value="servicioEdicion.Descripcion" />
                                    }
                                    else
                                    {
                                        @serv.Descripcion
                                    }
                                </td>
                                <td class="fw-bold text-dark">
                                    @if (idServicioEdicion == serv.IdServicio)
                                    {
                                        <input type="number" class="form-control form-control-sm shadow-sm" @bind-value="servicioEdicion.Precio" step="0.01" />
                                    }
                                    else
                                    {
                                        <span>Q @serv.Precio.ToString("F2", CultureInfo.InvariantCulture)</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    @if (idServicioEdicion == serv.IdServicio)
                                    {
                                        <button class="btn btn-sm btn-success me-1 fw-bold shadow-sm px-3" @onclick="ExecuteModificacion">Guardar</button>
                                        <button class="btn btn-sm btn-secondary fw-bold shadow-sm px-3" @onclick="AbortEdicion">Cancelar</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm text-white fw-bold me-2 px-3 py-1 shadow-sm" 
                                                style="background-color: #f0ad4e; border-color: #f0ad4e; border-radius: 6px;" 
                                                @onclick="() => StartEdicion(serv)">
                                            Editar
                                        </button>
                                        <button class="btn btn-sm text-white fw-bold px-3 py-1 shadow-sm" 
                                                style="background-color: #d9534f; border-color: #d9534f; border-radius: 6px;" 
                                                @onclick="() => ExecuteBaja(serv)">
                                            Eliminar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center px-2 mb-5">
        <div class="text-muted" style="font-size: 0.95rem;">
            Mostrando página <span class="fw-bold text-dark">@currentPage</span> de <span class="fw-bold text-dark">@totalPages</span> (@totalRecords registros totales)
        </div>
        
        <div class="d-flex align-items-center shadow-sm rounded overflow-hidden border">
            <button class="btn btn-light btn-sm px-3 py-2 fw-bold text-secondary" 
                    style="background-color: #f8f9fa; border-radius: 0;" 
                    disabled="@(currentPage == 1)" 
                    @onclick="() => GoToPage(currentPage - 1)">
                Anterior
            </button>
            <span class="px-4 py-2 text-white fw-bold" style="background-color: #0d6efd; font-size: 0.95rem; min-width: 45px; text-align: center;">
                @currentPage
            </span>
            <button class="btn btn-light btn-sm px-3 py-2 fw-bold text-secondary" 
                    style="background-color: #f8f9fa; border-radius: 0;" 
                    disabled="@(currentPage == totalPages)" 
                    @onclick="() => GoToPage(currentPage + 1)">
                Siguiente
            </button>
        </div>
    </div>
</div>

@if (mostrarModalCategorias)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.5); z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1070; top: 5%;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header text-white align-items-center py-3" style="background-color: #5d4037; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h5 class="modal-title fw-bold m-0">Gestionar Tipos de Servicio</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CerrarModalCategorias"></button>
                </div>
                <div class="modal-body p-4 bg-white" style="max-height: 70vh; overflow-y: auto;">
                    
                    <div class="card p-3 mb-4 border-0 shadow-sm" style="background-color: #efebe9; border-radius: 8px;">
                        <h6 class="fw-bold mb-3" style="color: #5d4037;">Registrar Nuevo Tipo</h6>
                        <EditForm Model="@nuevoTipo" OnValidSubmit="HandleCrearCategoria">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted">NOMBRE</label>
                                    <InputText @bind-Value="nuevoTipo.Nombre" class="form-control form-control-sm" placeholder="Ej. Spa, Transporte" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">DESCRIPCIÓN</label>
                                    <InputText @bind-Value="nuevoTipo.Descripcion" class="form-control form-control-sm" placeholder="Descripción corta..." />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-sm text-white fw-bold w-100 py-2 shadow-sm" style="background-color: #2d5a27;">
                                        Guardar
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>

                    <div class="mb-3">
                        <div class="input-group input-group-sm border rounded-pill bg-white px-2 shadow-sm">
                            <span class="input-group-text bg-white border-0 text-muted">Buscar</span>
                            <input type="text" class="form-control border-0 bg-white" placeholder="Filtrar tipos por nombre..." @bind="filtroCategoria" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="border rounded overflow-hidden shadow-sm">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead style="background-color: #2d5a27; color: white;">
                                <tr>
                                    <th class="ps-3 py-2" style="width: 80px;">ID</th>
                                    <th class="py-2">Nombre</th>
                                    <th class="py-2">Descripción</th>
                                    <th class="text-center py-2" style="width: 200px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (listaCategorias == null)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4">
                                            <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                                        </td>
                                    </tr>
                                }
                                else if (!CategoriasFiltradas.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No se encontraron tipos de servicio.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var c in CategoriasFiltradas)
                                    {
                                        <tr style="@(tipoEdicion?.IdTipoServicio == c.IdTipoServicio ? "background-color: #fffde7;" : "")">
                                            <td class="ps-3">
                                                <span class="badge text-white fw-bold d-flex align-items-center justify-content-center" 
                                                      style="width: 28px; height: 28px; background-color: #7A6356; border-radius: 4px; font-size: 0.85rem;">
                                                    @c.IdTipoServicio
                                                </span>
                                            </td>
                                            <td>
                                                @if (tipoEdicion?.IdTipoServicio == c.IdTipoServicio)
                                                {
                                                    <input type="text" class="form-control form-control-sm" @bind="editNombre" />
                                                }
                                                else
                                                {
                                                    <span class="fw-bold text-dark">@c.Nombre</span>
                                                }
                                            </td>
                                            <td>
                                                @if (tipoEdicion?.IdTipoServicio == c.IdTipoServicio)
                                                {
                                                    <input type="text" class="form-control form-control-sm" @bind="editDescripcion" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">@(string.IsNullOrEmpty(c.Descripcion) ? "—" : c.Descripcion)</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (tipoEdicion?.IdTipoServicio == c.IdTipoServicio)
                                                {
                                                    <button class="btn btn-xs btn-success fw-bold px-2 py-1 me-1 shadow-sm" style="font-size:0.8rem;" @onclick="GuardarCambiosCategoria">Guardar</button>
                                                    <button class="btn btn-xs btn-secondary fw-bold px-2 py-1 shadow-sm" style="font-size:0.8rem;" @onclick="CancelarEdicionCategoria">X</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-xs text-white fw-bold me-1 px-2 py-1 shadow-sm" style="background-color: #f0ad4e; font-size:0.8rem;" @onclick="() => IniciarEdicionCategoria(c)">Editar</button>
                                                    <button class="btn btn-xs text-white fw-bold px-2 py-1 shadow-sm" style="background-color: #d9534f; font-size:0.8rem;" @onclick="() => EliminarCategoria(c)">Eliminar</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-sm btn-secondary fw-bold px-3" @onclick="CerrarModalCategorias">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModal)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.5); z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050; top: 15%;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 8px;">
                <div class="modal-header text-white align-items-center py-3" style="background-color: #1b4d22; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                    <h5 class="modal-title fw-bold" style="font-size: 1.1rem;">Nuevo Servicio en Sistema</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Nombre del Servicio *</label>
                        <input type="text" class="form-control border shadow-sm" placeholder="Ej. Alquiler de Kayak" @bind-value="nuevoServicio.Nombre" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Tipo de Servicio / Categoría *</label>
                        <select class="form-select border shadow-sm" @bind="IdTipoServicioSeleccionado">
                            <option value="0">-- Seleccione una Categoría --</option>
                            @if (listaCategorias != null)
                            {
                                @foreach (var tipo in listaCategorias)
                                {
                                    <option value="@tipo.IdTipoServicio">@tipo.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Descripción Corta *</label>
                        <input type="text" class="form-control border shadow-sm" placeholder="Detalles de la actividad..." @bind-value="nuevoServicio.Descripcion" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark" style="font-size: 0.9rem;">Precio Base de Venta (Q) *</label>
                        <input type="number" class="form-control border shadow-sm" @bind-value="nuevoServicio.Precio" step="0.01" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-top d-flex justify-content-end gap-2 py-3 px-4" style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                    <button type="button" class="btn btn-secondary fw-bold px-3" style="background-color: #6c757d;" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn text-white fw-bold px-3" style="background-color: #1b4d22;" @onclick="ExecuteAlta">Guardar Servicio</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private HiddenValley.Shared.DTOs.ServicioCreateDto nuevoServicio = new();
    private List<HiddenValley.Shared.DTOs.ServicioReadDto>? listaServiciosVisual;

    private TipoServicioCreateDto nuevoTipo = new();
    private List<TipoServicioReadDto>? listaCategorias;
    private TipoServicioReadDto? tipoEdicion;
    private string filtroCategoria = "";
    private string editNombre = "";
    private string? editDescripcion;
    private bool mostrarModalCategorias = false;

    // Propiedad intermedia independiente para capturar el ID en la interfaz
    private int IdTipoServicioSeleccionado { get; set; } = 0;

    private string? searchNombre = "";
    private int? searchId;

    private int currentPage = 1;
    private int pageSize = 5; 
    private int totalRecords = 0;
    private int totalPages = 1;

    private bool mostrarModal = false;

    private HiddenValley.Shared.DTOs.UpdateServicioDto servicioEdicion = new();
    private int idServicioEdicion = 0;

    private List<TipoServicioReadDto> CategoriasFiltradas =>
        listaCategorias?.Where(t =>
            string.IsNullOrEmpty(filtroCategoria) ||
            t.Nombre.Contains(filtroCategoria, StringComparison.OrdinalIgnoreCase) ||
            (t.Descripcion != null && t.Descripcion.Contains(filtroCategoria, StringComparison.OrdinalIgnoreCase))
        ).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await CargarCategorias(); 
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var resultCompleto = await ServicioService.GetPagedAsync(1, 1000, searchNombre, searchId);
            var listaCompleta = resultCompleto?.OrderBy(s => s.IdServicio).ToList() ?? new List<HiddenValley.Shared.DTOs.ServicioReadDto>();

            totalRecords = listaCompleta.Count;
            totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);
            if (totalPages < 1) totalPages = 1;

            if (currentPage > totalPages) currentPage = totalPages;

            listaServiciosVisual = listaCompleta
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar registros: {ex.Message}");
            listaServiciosVisual = new List<HiddenValley.Shared.DTOs.ServicioReadDto>();
            totalRecords = 0;
            totalPages = 1;
        }
        StateHasChanged();
    }

    private async Task AbrirModalCategorias()
    {
        mostrarModalCategorias = true;
        filtroCategoria = "";
        await CargarCategorias();
    }

    private void CerrarModalCategorias() => mostrarModalCategorias = false;

    private async Task CargarCategorias()
    {
        try
        {
            listaCategorias = await TipoServicioService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al traer categorías: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task HandleCrearCategoria()
    {
        if (await TipoServicioService.CrearAsync(nuevoTipo))
        {
            await JS.InvokeVoidAsync("alert", "Tipo de servicio creado correctamente.");
            nuevoTipo = new();
            await CargarCategorias(); 
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al crear el tipo de servicio.");
        }
    }

    private void IniciarEdicionCategoria(TipoServicioReadDto t)
    {
        tipoEdicion = t;
        editNombre = t.Nombre;
        editDescripcion = t.Descripcion;
    }

    private void CancelarEdicionCategoria()
    {
        tipoEdicion = null;
        editNombre = "";
        editDescripcion = null;
    }

    private async Task GuardarCambiosCategoria()
    {
        if (tipoEdicion == null) return;

        var dto = new TipoServicioCreateDto { Nombre = editNombre, Descripcion = editDescripcion };

        if (await TipoServicioService.ActualizarAsync(tipoEdicion.IdTipoServicio, dto))
        {
            await JS.InvokeVoidAsync("alert", "Tipo de servicio actualizado correctamente.");
            CancelarEdicionCategoria();
            await CargarCategorias();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Error al actualizar el tipo de servicio.");
        }
    }

    private async Task EliminarCategoria(TipoServicioReadDto t)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", $"¿Seguro que desea eliminar el tipo '{t.Nombre}'?");
        if (!confirmar) return;

        var resultado = await TipoServicioService.EliminarAsync(t.IdTipoServicio);
        
        if (resultado.GetType() == typeof(bool) && (bool)(object)resultado)
        {
            await JS.InvokeVoidAsync("alert", "Tipo de servicio eliminado.");
            await CargarCategorias();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "No se pudo eliminar. Es posible que tenga servicios activos asociados.");
        }
    }

    private void AbrirModal() 
    { 
        mostrarModal = true; 
        nuevoServicio = new(); 
        IdTipoServicioSeleccionado = 0; 
    }
    
    private void CerrarModal() { mostrarModal = false; }

    private async Task ExecuteSearch()
    {
        currentPage = 1; 
        await LoadDataAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadDataAsync();
    }

    private async Task ExecuteAlta()
    {
        if (string.IsNullOrWhiteSpace(nuevoServicio.Nombre) || 
            string.IsNullOrWhiteSpace(nuevoServicio.Descripcion) || 
            nuevoServicio.Precio <= 0 ||
            IdTipoServicioSeleccionado == 0)
        {
            await JS.InvokeVoidAsync("alert", "Error: Todos los campos con (*) son requeridos.");
            return;
        }

        // NOTA: Si necesitas enviar el ID del tipo seleccionado a tu API, descomenta la línea de abajo 
        // y reemplaza "TuPropiedadId" por el nombre real exacto que tenga en tu clase 'ServicioCreateDto':
        // nuevoServicio.TuPropiedadId = IdTipoServicioSeleccionado;

        var result = await ServicioService.CreateServicioAsync(nuevoServicio);
        if (result != null)
        {
            CerrarModal();
            currentPage = 1; 
            await LoadDataAsync();
        }
    }

    private void StartEdicion(HiddenValley.Shared.DTOs.ServicioReadDto serv)
    {
        idServicioEdicion = serv.IdServicio;
        servicioEdicion = new HiddenValley.Shared.DTOs.UpdateServicioDto { Nombre = serv.Nombre, Descripcion = serv.Descripcion, Precio = serv.Precio };
    }

    private void AbortEdicion() { servicioEdicion = new HiddenValley.Shared.DTOs.UpdateServicioDto(); idServicioEdicion = 0; }

    private async Task ExecuteModificacion()
    {
        if (idServicioEdicion == 0) return;

        bool success = await ServicioService.PatchAsync(idServicioEdicion, servicioEdicion);
        if (success)
        {
            AbortEdicion();
            await LoadDataAsync();
        }
    }

    private async Task ExecuteBaja(HiddenValley.Shared.DTOs.ServicioReadDto serv)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Remover el servicio '{serv.Nombre}' del sistema?");
        if (!confirm) return;

        bool success = await ServicioService.DeleteServicioAsync(serv.IdServicio);
        if (success)
        {
            await LoadDataAsync();
        }
    }
}