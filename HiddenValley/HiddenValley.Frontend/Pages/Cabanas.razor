    //tipos de cabaña
    private async Task CargarTiposCabana()
    {
        listaTiposCabana = await TipoCabanaService.GetAllAsync();
    }

    private async Task AbrirModalTiposBtn()
    {
        mostrarModalTipos = true;
        await CargarTiposCabana();
    }

    private void CerrarModalTipos()
    {
        mostrarModalTipos = false;
        CancelarEdicionTipo();
    }

    private async Task HandleCrearTipo()
    {
        if (string.IsNullOrWhiteSpace(nuevoTipoDto.Nombre) || nuevoTipoDto.Precio <= 0)
        {
            await jsRuntime.InvokeVoidAsync("alert", "Error: El Nombre es obligatorio y el Precio debe ser mayor a 0.");
            return;
        }

        try
        {
            var resultado = await TipoCabanaService.CreateAsync(nuevoTipoDto);
            if (resultado != null && resultado.IdTipoCabana > 0)
            {
                await jsRuntime.InvokeVoidAsync("alert", "Categoría registrada con éxito.");
                nuevoTipoDto = new TipoCabanaCreateDTO() { Capacidad = 2, Precio = 0 }; // Reset
                await CargarTiposCabana();
            }
        }
        catch (Exception ex)
        {
            await jsRuntime.InvokeVoidAsync("alert", $"Error del servidor: {ex.Message}");
        }
    }

    private void IniciarEdicionTipo(TipoCabanaDTO tipo)
    {
        tipoSeleccionadoEdicion = tipo;
        editNombre = tipo.Nombre;
        editDescripcion = tipo.Descripcion ?? "";
        editCapacidad = tipo.Capacidad;
        editPrecio = tipo.Precio;
    }

    private void CancelarEdicionTipo()
    {
        tipoSeleccionadoEdicion = null;
        editNombre = "";
        editDescripcion = "";
        editCapacidad = 2;
        editPrecio = 0;
    }

    private async Task GuardarCambiosTipo()
    {
        if (tipoSeleccionadoEdicion == null) return;

        if (string.IsNullOrWhiteSpace(editNombre) || editPrecio <= 0)
        {
            await jsRuntime.InvokeVoidAsync("alert", "Error: El nombre no puede estar vacío y el precio debe ser mayor a 0.");
            return;
        }

        var updateDto = new TipoCabanaCreateDTO 
        { 
            Nombre = editNombre, 
            Descripcion = editDescripcion,
            Capacidad = editCapacidad,
            Precio = editPrecio 
        };

        var (success, message) = await TipoCabanaService.UpdateAsync(tipoSeleccionadoEdicion.IdTipoCabana, updateDto);

        if (success)
        {
            await jsRuntime.InvokeVoidAsync("alert", "Categoría modificada con éxito.");
            CancelarEdicionTipo();
            await CargarTiposCabana();
        }
        else
        {
            await jsRuntime.InvokeVoidAsync("alert", $"No se pudo actualizar: {message}");
        }
    }

    private async Task EliminarTipo(TipoCabanaDTO tipo)
    {
        bool confirmar = await jsRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro de eliminar de forma definitiva la categoría '{tipo.Nombre}'?");
        if (!confirmar) return;

        var (success, message) = await TipoCabanaService.DeleteAsync(tipo.IdTipoCabana);
        
        if (success)
        {
            await jsRuntime.InvokeVoidAsync("alert", "Categoría eliminada de forma definitiva.");
            await CargarTiposCabana();
        }
        else
        {
            await jsRuntime.InvokeVoidAsync("alert", $"Acción Bloqueada: {message}");
        }
    }
}